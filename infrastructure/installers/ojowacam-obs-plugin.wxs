<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Ojowacam OBS Plugin"
           Language="1033"
           Version="1.0.0"
           Manufacturer="Ojowacam Team"
           UpgradeCode="a2c3e4f6-8b10-4d12-9a34-5c6e7f8091ab">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer Ojowacam OBS Plugin is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="AppDataFolder">
        <Directory Id="OBSFolder" Name="obs-studio">
          <Directory Id="OBSPluginsFolder" Name="plugins">
            <Directory Id="PluginInstallFolder" Name="ojowacam-obs" />
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="PluginInstallFolder">
      <Component Id="ObsPluginFilesComponent" Guid="b3d4f5a7-9c21-4e31-8b45-6d7f8091a2bc">
        <File Id="OjowacamObsPluginDll"
              Source="$(var.PluginDir)\ojowacam-obs.dll" />
        <File Id="OjowacamObsModuleJson"
              Source="$(var.PluginDir)\module.json" />
        <RemoveFolder Id="RemovePluginInstallFolder" Directory="PluginInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveObsPluginsFolder" Directory="OBSPluginsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveObsFolder" Directory="OBSFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Ojowacam\ObsPlugin"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ObsPluginFeature" Title="Ojowacam OBS Plugin" Level="1">
      <ComponentRef Id="ObsPluginFilesComponent" />
    </Feature>
  </Product>
</Wix>
