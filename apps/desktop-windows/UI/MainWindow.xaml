<Window x:Class="Ojowacam.Desktop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ojowacam Desktop"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Device Discovery & Connection -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="20">
                    <TextBlock Text="Ojowacam Desktop" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#1a1a1a" />
                    
                    <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#333" />
                    <ListBox x:Name="DeviceList" Height="200" Margin="0,0,0,20" SelectionChanged="DeviceList_SelectionChanged">
                        <ListBoxItem Content="No devices found" IsEnabled="False" />
                    </ListBox>
                    
                    <Button Content="Scan for Devices" Style="{StaticResource PrimaryButton}" 
                            Margin="0,0,0,20" Click="ScanDevices_Click" />
                    
                    <TextBlock Text="Connection Status" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#333" />
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#666" Margin="0,0,0,20" />
                    
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Video Quality" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#333" />
                        <ComboBox x:Name="QualityCombo" SelectedIndex="1">
                            <ComboBoxItem Content="720p 30fps" />
                            <ComboBoxItem Content="1080p 30fps" />
                            <ComboBoxItem Content="1080p 60fps" />
                            <ComboBoxItem Content="4K 30fps" />
                        </ComboBox>
                    </StackPanel>
                    
                    <Button Content="Connect" Style="{StaticResource PrimaryButton}" 
                            Margin="0,0,0,10" Click="Connect_Click" IsEnabled="False" x:Name="ConnectButton" />
                    <Button Content="Disconnect" Background="#FF3B30" Foreground="White" 
                            Margin="0,0,0,20" Click="Disconnect_Click" IsEnabled="False" x:Name="DisconnectButton" />
                    
                    <TextBlock Text="Stats" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#333" />
                    <TextBlock x:Name="LatencyText" Text="Latency: -- ms" Foreground="#666" />
                    <TextBlock x:Name="BitrateText" Text="Bitrate: -- Mbps" Foreground="#666" />
                    <TextBlock x:Name="FpsText" Text="FPS: --" Foreground="#666" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel: Video Preview & Controls -->
        <Border Grid.Column="1" Background="#000">
            <Grid>
                <!-- Video Preview Area -->
                <Image x:Name="VideoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="NoVideoText" Text="No video stream" Foreground="#888" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />

                <!-- Controls Overlay -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                            Margin="20" Orientation="Horizontal">
                    <Button Content="Switch Camera" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Click="SwitchCamera_Click" IsEnabled="False" x:Name="SwitchCameraButton" />
                    <Button Content="Torch" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Click="Torch_Click" IsEnabled="False" x:Name="TorchButton" />
                    <Button Content="Stop Streaming" Background="#FF3B30" 
                            Foreground="White" Padding="16,8" Click="StopStreaming_Click" IsEnabled="False" x:Name="StopStreamingButton" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
