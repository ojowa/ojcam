<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Ojowacam Desktop"
           Language="1033"
           Version="1.0.0"
           Manufacturer="Ojowacam Team"
           UpgradeCode="7d1e3a4b-5c6f-4a2b-9d8e-7f6a5b4c3d2e">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Ojowacam is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Ojowacam Desktop" />
      </Directory>
      <Directory Id="CommonProgramMenuFolder">
        <Directory Id="OJOWACAM_MENU" Name="Ojowacam" />
      </Directory>
    </Directory>

    <DirectoryRef Id="OJOWACAM_MENU">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopStartMenuShortcut"
                  Name="Ojowacam Desktop"
                  Description="Ojowacam - Your Phone. Your Camera. Your Studio."
                  Target="[INSTALLFOLDER]Ojowacam.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveOjowacamMenu" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\Ojowacam\Desktop"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Ojowacam Desktop" Level="1">
      <ComponentGroupRef Id="DesktopPublishFiles" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
    </UI>
  </Product>
</Wix>
