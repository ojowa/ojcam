{
  "name": "@ojowacam/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "expo": "^49.0.0",
    "expo-camera": "^13.4.0",
    "expo-av": "^13.4.0",
    "expo-screen-orientation": "^6.1.0",
    "expo-keep-awake": "^12.3.0",
    "expo-file-system": "^15.4.0",
    "expo-secure-store": "^12.3.0",
    "react-native-udp": "^4.1.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-webrtc": "^155.0.1",
    "react-native-reanimated": "^3.6.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-screens": "^3.29.0",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/stack": "^6.3.17",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.1.3",
    "jest": "^29.7.0",
    "jest-expo": "^49.0.0",
    "@types/jest": "^29.5.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/__tests__/**/*.tsx",
      "**/?(*.)+(spec|test).ts",
      "**/?(*.)+(spec|test).tsx"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
