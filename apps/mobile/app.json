{
  "expo": {
    "name": "Ojowacam",
    "slug": "ojowacam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "cameraUsageDescription": "Ojowacam needs access to your camera to stream video.",
      "microphoneUsageDescription": "Ojowacam needs access to your microphone to stream audio."
    },
    "android": {
      "package": "com.ojowacam.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-av",
      "expo-screen-orientation",
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": "7d0e73c0-14be-4170-8ca8-035989f8f30f"
      }
    },
    "owner": "afolayan"
  }
}
